<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .skills-row {
            display: flex;
            justify-content: center;
            gap: 1rem;
            margin-bottom: 1rem;
            flex-wrap: wrap;
        }
        
        .skill-card {
            flex: 0 0 auto;
            width: 200px;
            transition: transform 0.3s ease;
        }
        
        .skill-card:hover {
            transform: translateY(-5px);
        }
        
        .hidden-row {
            display: none;
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        
        .hidden-row.show {
            display: flex;
            opacity: 1;
        }
        
        .btn-container {
            display: flex;
            justify-content: center;
            margin-top: 2rem;
        }
        
        @media (max-width: 768px) {
            .skill-card {
                width: 150px;
            }
        }
    </style>
</head>
<body>
    <div class="container py-5">
        <h2 class="text-center mb-4">Habilidades y tecnologías que domino</h2>
        
        <!-- Primera fila -->
        <div class="skills-row">
            <div class="skill-card">
                <div class="card h-100 border-0 text-center">
                    <div class="card-body">
                        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/javascript/javascript-original.svg" 
                             alt="Javascript" 
                             class="img-fluid mb-3"
                             style="width: 64px; height: 64px;">
                        <h5 class="card-title">Javascript</h5>
                    </div>
                </div>
            </div>
            
            <div class="skill-card">
                <div class="card h-100 border-0 text-center">
                    <div class="card-body">
                        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg" 
                             alt="React" 
                             class="img-fluid mb-3"
                             style="width: 64px; height: 64px;">
                        <h5 class="card-title">React</h5>
                    </div>
                </div>
            </div>
            
            <div class="skill-card">
                <div class="card h-100 border-0 text-center">
                    <div class="card-body">
                        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg" 
                             alt="PostgreSQL" 
                             class="img-fluid mb-3"
                             style="width: 64px; height: 64px;">
                        <h5 class="card-title">PostgreSQL</h5>
                    </div>
                </div>
            </div>
            
            <div class="skill-card">
                <div class="card h-100 border-0 text-center">
                    <div class="card-body">
                        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nodejs/nodejs-original.svg" 
                             alt="Node.js" 
                             class="img-fluid mb-3"
                             style="width: 64px; height: 64px;">
                        <h5 class="card-title">Node.js</h5>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Segunda fila (oculta) -->
        <div class="skills-row hidden-row" id="hiddenRow">
            <div class="skill-card">
                <div class="card h-100 border-0 text-center">
                    <div class="card-body">
                        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/sass/sass-original.svg" 
                             alt="Sass/Scss" 
                             class="img-fluid mb-3"
                             style="width: 64px; height: 64px;">
                        <h5 class="card-title">Sass/Scss</h5>
                    </div>
                </div>
            </div>
            
            <div class="skill-card">
                <div class="card h-100 border-0 text-center">
                    <div class="card-body">
                        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/tailwindcss/tailwindcss-plain.svg" 
                             alt="Tailwind CSS" 
                             class="img-fluid mb-3"
                             style="width: 64px; height: 64px;">
                        <h5 class="card-title">Tailwind CSS</h5>
                    </div>
                </div>
            </div>
            
            <div class="skill-card">
                <div class="card h-100 border-0 text-center">
                    <div class="card-body">
                        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/figma/figma-original.svg" 
                             alt="Figma" 
                             class="img-fluid mb-3"
                             style="width: 64px; height: 64px;">
                        <h5 class="card-title">Figma</h5>
                    </div>
                </div>
            </div>
            
            <div class="skill-card">
                <div class="card h-100 border-0 text-center">
                    <div class="card-body">
                        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/git/git-original.svg" 
                             alt="Git" 
                             class="img-fluid mb-3"
                             style="width: 64px; height: 64px;">
                        <h5 class="card-title">Git</h5>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="btn-container">
            <button class="btn btn-primary" id="toggleButton">Ver más</button>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const toggleButton = document.getElementById('toggleButton');
            const hiddenRow = document.getElementById('hiddenRow');
            let isShowingAll = false;

            toggleButton.addEventListener('click', function() {
                isShowingAll = !isShowingAll;
                hiddenRow.classList.toggle('show');
                toggleButton.textContent = isShowingAll ? 'Ver menos' : 'Ver más';
            });
        });
    </script>
</body>
</html>